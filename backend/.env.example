# Copy to backend/.env for local `npm run start:dev` (optional; docker uses repo root `.env`)

NODE_ENV=development
PORT=3001

# Option A: single URL
DATABASE_URL=postgresql://noir_admin:noir_password_2026@localhost:5432/noir_ride

# Option B: discrete vars (used if DATABASE_URL is unset or invalid)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=noir_admin
DB_PASSWORD=noir_password_2026
DB_DATABASE=noir_ride

JWT_SECRET=dev_change_me_use_long_random_string
FRONTEND_URL=http://localhost:3000

# Telegram bot notifications (optional — leave empty to disable)
# 1. Create bot via @BotFather → get TELEGRAM_BOT_TOKEN
# 2. Get your chat/channel id: send a message to the bot and call
#    https://api.telegram.org/bot<TOKEN>/getUpdates  → look for "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YooKassa online payment
# Register at https://yookassa.ru → merchant dashboard → HTTP-notifications → https://your-domain.ru/payment/webhook
YOOKASSA_SHOP_ID=1404589
YOOKASSA_SECRET_KEY=test_ZljNM2A4-YAvMefIkor9cVs4QcO6GtHz7BpkX0qrIT4

# Auto schema in dev; never leave true in production after first migrate
DB_SYNC=false
